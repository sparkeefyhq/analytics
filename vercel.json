{
  "version": 2,
  "buildCommand": "node scripts/build-vercel-api.mjs && npx vite build --config vercel-static/vite.config.ts",
  "outputDirectory": "vercel-static/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/native?path=/api/$1" },
    { "source": "/analytics", "destination": "/index.html" },
    { "source": "/plan", "destination": "/index.html" },
    { "source": "/users", "destination": "/index.html" },
    { "source": "/launch", "destination": "/index.html" },
    { "source": "/sarthak", "destination": "/index.html" },
    { "source": "/suggestions", "destination": "/index.html" }
  ]
}
